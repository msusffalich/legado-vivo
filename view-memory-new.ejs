<%- include('view-inc-familytabs', { tab: 'memories' }) %>
<h1><%= t('new_memory') %></h1>
<div class="card">
<form id="memory-form" method="post" action="/families/<%= family.id %>/memories" enctype="multipart/form-data">
  <label><%= t('memory_title') %> *<input name="title" required maxlength="200"></label>

  <p class="muted small"><%= lang === 'en' ? 'HEIC/HEIF and other supported photos are converted to JPEG; videos to MP4 with their audio. Conversion runs after upload. Original files are kept on the server. Animated or multi-image photos use their first still image.' : 'Las fotos HEIC/HEIF y los demás formatos compatibles se convierten a JPEG; los videos, a MP4 con su audio. La conversión continúa después de la carga. Los originales se conservan en el servidor. En fotos animadas o con varias imágenes se usa la primera imagen fija.' %></p>
  <div class="two">
    <label><%= t('photo_label') %> <span class="muted">(<%= t('optional') %>)</span><input type="file" name="photo" accept="image/*,.heic,.heif,.hif,.avif,.tif,.tiff,.bmp,.webp,.gif,.svg,.ico,.dng,.cr2,.cr3,.crw,.nef,.arw,.rw2,.orf,.pef,.srw,.raf,.raw,.psd"></label>
    <label><%= t('audio_label') %> <span class="muted">(<%= t('optional') %>)</span><input type="file" name="audio" accept="audio/*"></label>
  </div>
  <label><%= t('photo_url_label') %> <span class="muted">(<%= t('optional') %>)</span>
    <input type="url" name="photo_url" inputmode="url" placeholder="https://…/foto.jpg">
    <span class="muted small"><%= t('photo_url_hint') %></span></label>
  <label><%= t('video_label') %> <span class="muted">(<%= t('optional') %> · <%= t('video_max_hint') %>)</span><input type="file" name="video" accept="video/*,.mp4,.m4v,.mov,.avi,.mkv,.webm,.wmv,.flv,.3gp,.3g2,.mts,.m2ts,.ts,.mpg,.mpeg,.ogv"></label>
  <label><%= t('video_url_label') %> <span class="muted">(<%= t('optional') %>)</span>
    <input type="url" name="video_url" inputmode="url" placeholder="https://www.youtube.com/watch?v=… / https://www.instagram.com/reel/…">
    <span class="muted small"><%= t('video_url_hint') %></span></label>
  <label><%= t('doc_label') %> <span class="muted">(<%= t('optional') %>)</span><input type="file" name="document" accept=".pdf,.docx,.txt,.md">
    <span class="muted small"><%= t('doc_hint') %></span></label>
  <p class="muted small">📋 <%= t('paste_hint') %></p>
  <% if (typeof aiEnabled !== 'undefined' && aiEnabled) { %>
  <label class="check"><input type="checkbox" name="ai_comment_gen" value="1"> <strong><%= t('ai_comment_generate') %></strong>
    <span class="muted small"><%= t('ai_comment_hint') %></span></label>
  <% } %>

  <label><%= t('transcription_label') %> <span class="muted">(<%= t('optional') %>)</span>
    <textarea name="transcription" rows="3" placeholder="<%= t('transcription_hint') %>"></textarea></label>

  <label><%= t('story_label') %><textarea id="story" name="story" rows="6" placeholder="<%= t('story_hint') %>"></textarea></label>

  <details class="interview">
    <summary><strong><%= t('interview_title') %></strong> <span class="muted">— <%= t('interview_hint') %></span></summary>
    <label><%= t('iq_see') %><textarea name="iq_see" rows="2"></textarea></label>
    <label><%= t('iq_who') %><textarea name="iq_who" rows="2"></textarea></label>
    <label><%= t('iq_where') %><input name="iq_where"></label>
    <label><%= t('iq_when') %><input name="iq_when"></label>
    <label><%= t('iq_remember') %><textarea name="iq_remember" rows="3"></textarea></label>
    <button class="btn ghost small" type="button" onclick="addInterview()"><%= t('add_answers') %></button>
  </details>

  <div class="two">
    <label><%= t('place_label') %><input name="place" maxlength="200"></label>
    <label><%= t('date_label') %> <span class="muted">(<%= t('date_hint') %>)</span><input type="date" name="memory_date"></label>
  </div>
  <label><%= t('date_precision') %>
    <select name="date_precision">
      <option value="unknown"><%= t('precision_unknown') %></option>
      <option value="exact"><%= t('precision_exact') %></option>
      <option value="approx"><%= t('precision_approx') %></option>
    </select>
  </label>

  <% if (persons.length) { %>
  <fieldset><legend><%= t('people_label') %></legend>
    <div class="checks">
    <% persons.forEach(function(p) { %>
      <label class="check"><input type="checkbox" name="person_ids" value="<%= p.id %>"> <%= p.name %></label>
    <% }); %>
    </div>
  </fieldset>
  <% } else { %><p class="muted"><%= t('no_people_hint') %></p><% } %>

  <p><button class="btn" type="submit"><%= t('save_memory') %></button>
  <a class="btn ghost" href="/families/<%= family.id %>/memories"><%= t('cancel') %></a></p>
  <%- include('view-inc-uploadprogress') %>
</form>
</div>

