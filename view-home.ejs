</section>
<section>
  <h2><%= t('home_how') %></h2>
  <div class="steps">
    <div class="card"><h3><%= t('home_s1t') %></h3><p><%= t('home_s1d') %></p></div>
    <div class="card"><h3><%= t('home_s2t') %></h3><p><%= t('home_s2d') %></p></div>
    <div class="card"><h3><%= t('home_s3t') %></h3><p><%= t('home_s3d') %></p></div>
  </div>
</section>
