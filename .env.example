# Copia este archivo como .env (solo para desarrollo local).
# En Railway, configura estas mismas variables en la pestaña Variables del servicio.

# PostgreSQL (Railway la inyecta automáticamente como DATABASE_URL al agregar el plugin Postgres)
DATABASE_URL=postgres://legado:legado@localhost:5432/legadovivo

# Secreto para firmar las sesiones (genera uno largo y único en producción)
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-unico

# URL pública de la app (la que Railway te asigne, ej. https://legado-vivo.up.railway.app)
# Se usa en los mensajes de invitación por WhatsApp.
APP_URL=http://localhost:3000

# Puerto (Railway lo inyecta automáticamente como PORT)
PORT=3000

# Carpeta donde se guardan fotos y audios. En Railway monta un Volume y apunta aquí,
# ej. UPLOAD_DIR=/data/uploads
UPLOAD_DIR=./uploads

# Clave del puente con el Asistente Puente (el asistente la envía como header x-bridge-key).
# Genera una larga y única.
BRIDGE_API_KEY=cambia-esta-clave-puente

# OpenAI (opcional). Sin esta clave, las historias y la búsqueda conversacional
# muestran un aviso y la app sigue funcionando con búsqueda por palabras clave.
OPENAI_API_KEY=
# Modelo (opcional)
OPENAI_MODEL=gpt-4o-mini

NODE_ENV=development
