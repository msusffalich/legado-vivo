<% const showTab = (typeof tab !== 'undefined' ? tab : 'memories'); %>
<div class="row between">
  <div>
    <h1><%= family.name %></h1>
    <% if (family.description) { %><p class="muted"><%= family.description %></p><% } %>
    <p class="muted small"><%= t('your_role', { role: roleName(membership.role) }) %></p>
  </div>
</div>

<%- include('view-inc-familytabs', { tab: showTab }) %>

<% if (showTab === 'members' && membership.role === 'admin') { %>
  <h2><%= t('members') %></h2>
  <div class="card">
  <table class="tbl">
    <tr><th><%= t('name') %></th><th><%= t('email') %></th><th><%= t('role') %></th><th></th></tr>
    <% members.forEach(function(m) { %>
      <tr>
        <td><%= m.name %></td><td class="muted"><%= m.email %></td>
        <td>
          <form class="inline" method="post" action="/families/<%= family.id %>/members/<%= m.id %>/role">
            <select name="role" onchange="this.form.submit()">
              <option value="admin"<%= m.role === 'admin' ? ' selected' : '' %>><%= t('admin') %></option>
              <option value="collaborator"<%= m.role === 'collaborator' ? ' selected' : '' %>><%= t('collaborator') %></option>
              <option value="reader"<%= m.role === 'reader' ? ' selected' : '' %>><%= t('reader') %></option>
            </select>
          </form>
          <div class="small muted"><%= t('role_admin_desc') %></div>
        </td>
        <td>
          <% if (m.user_id !== user.id) { %>
          <form class="inline" method="post" action="/families/<%= family.id %>/members/<%= m.id %>/remove"
                onsubmit="return confirm('<%= t('remove_member') %>?')">
            <button class="linkbtn danger" type="submit"><%= t('remove_member') %></button>
          </form>
          <% } %>
        </td>
      </tr>
    <% }); %>
  </table>
  </div>
<% } else if (showTab === 'settings' && membership.role === 'admin') { %>
  <h2><%= t('family_settings') %></h2>
  <div class="card">
    <form method="post" action="/families/<%= family.id %>">
      <label><%= t('family_name') %> *<input name="name" value="<%= family.name %>" required></label>
      <label><%= t('family_description') %><textarea name="description" rows="3"><%= family.description %></textarea></label>
      <button class="btn" type="submit"><%= t('save_changes') %></button>
    </form>
  </div>
  <div class="card danger-zone">
    <h3><%= t('danger_zone') %></h3>
    <p class="muted"><%= t('delete_family_confirm') %></p>
    <form method="post" action="/families/<%= family.id %>/delete">
      <label><%= t('type_family_name') %><input name="confirmName" required></label>
      <button class="btn danger" type="submit"><%= t('delete_family') %></button>
    </form>
  </div>
<% } else { %>
  <h2><%= t('memories') %></h2>
  <p><a class="btn" href="/families/<%= family.id %>/memories/new"><%= t('new_memory') %></a>
     <a class="btn ghost" href="/families/<%= family.id %>/memories"><%= t('view') %> →</a></p>
  <% if (!recent.length) { %><p class="muted"><%= t('no_memories') %></p><% } %>
  <div class="grid">
  <% recent.forEach(function(m) { %>
    <a class="card memcard" href="/families/<%= family.id %>/memories/<%= m.id %>">
      <% if (m.photo_path) { %><img src="<%= m.photo_path %>" alt=""><% } %>
      <h4><%= m.title %></h4>
      <p class="muted small"><%= fmtMemDate(m) %><% if (m.status === 'pending') { %> · ⏳ <%= t('status_pending') %><% } %></p>
    </a>
  <% }); %>
  </div>
<% } %>
